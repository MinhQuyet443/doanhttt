<div class="profile-wrapper">

    <div class="profile-card profile-form-card">

        <div class="profile-heading">

            <div>

                <h2>
                    Đổi mật khẩu
                </h2>

                <p>
                    Nhập mật khẩu hiện tại và mật khẩu mới.
                </p>

            </div>

        </div>


        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                @ViewBag.Error
            </div>
        }


        <form method="post"
              action="/Account/ChangePassword"
              class="profile-form">

            <label>
                Mật khẩu hiện tại
            </label>

            <input type="password"
                   name="currentPassword"
                   required />


            <label>
                Mật khẩu mới
            </label>

            <input type="password"
                   name="newPassword"
                   minlength="8"
                   required
                 


            <label>
                Xác nhận mật khẩu mới
            </label>

            <input type="password"
                   name="confirmPassword"
                   minlength="6"
                   required />


            <div class="profile-form-actions">

                <button type="submit"
                        class="profile-btn primary">

                    Đổi mật khẩu

                </button>


                <a href="/Account/Profile"
                   class="profile-btn light">

                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>