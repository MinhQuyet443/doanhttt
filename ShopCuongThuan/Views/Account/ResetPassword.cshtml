<div class="auth-wrapper">
    <div class="auth-box">
        <h2>Đặt lại mật khẩu</h2>

        <p class="login-note">
            Nhập mật khẩu mới cho tài khoản khách hàng của bạn.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/ResetPassword">
            <label>Mật khẩu mới</label>
            <input type="password" name="newPassword" placeholder="Nhập mật khẩu mới" required />

            <label>Nhập lại mật khẩu mới</label>
            <input type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" required />

            <button type="submit">Đổi mật khẩu</button>
        </form>
    </div>
</div>