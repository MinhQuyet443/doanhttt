<div class="auth-wrapper">
    <div class="auth-box">
        <h2>Xác nhận mã</h2>

        <p class="login-note">
            Vui lòng nhập mã 6 số đã được gửi về email của bạn.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/VerifyCode">
            <label>Mã xác nhận</label>
            <input type="text" name="code" maxlength="6" placeholder="Nhập mã 6 số" required />

            <button type="submit">Xác nhận mã</button>
        </form>

        <p>
            <a href="/Account/ForgotPassword">Gửi lại mã</a>
        </p>
    </div>
</div>