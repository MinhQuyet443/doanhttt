@{
    Layout = "_AdminLayout";
}

<div class="dashboard-grid">
    <div class="stat-card">
        <h3>Sản phẩm</h3>
        <strong>@ViewBag.SoSanPham</strong>
    </div>

    <div class="stat-card">
        <h3>Danh mục</h3>
        <strong>@ViewBag.SoDanhMuc</strong>
    </div>

    <div class="stat-card">
        <h3>Đơn hàng</h3>
        <strong>@ViewBag.SoDonHang</strong>
    </div>

    <div class="stat-card">
        <h3>Nhân viên</h3>
        <strong>@ViewBag.SoNhanVien</strong>
    </div>

    <div class="stat-card">
        <h3>Khuyến mãi</h3>
        <strong>@ViewBag.SoKhuyenMai</strong>
    </div>
</div>

<div class="admin-box" style="margin-top:24px">
    <h2>Trang quản trị hệ thống</h2>
    <p>
        Đây là khu vực quản trị dành cho nhân viên cửa hàng .
        Tại đây có thể quản lý sản phẩm, danh mục, đơn hàng, nhân viên và chương trình khuyến mãi.
    </p>
</div>