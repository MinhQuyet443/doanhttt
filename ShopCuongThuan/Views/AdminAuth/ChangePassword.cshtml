@{
    Layout = "_AdminLayout";
}

<div class="account-page">

    <div class="account-card account-form-card">

        <div class="account-form-heading">

            <div class="account-form-heading-icon">
                🔒
            </div>

            <div>

                <h2>Đổi mật khẩu</h2>

                <p>
                    Để bảo mật tài khoản, hãy sử dụng mật khẩu mạnh.
                </p>

            </div>

        </div>


        @if (ViewBag.Error != null)
        {
            <div class="account-alert-error">
                ⚠ @ViewBag.Error
            </div>
        }


        <form method="post"
              action="/AdminAuth/ChangePassword"
              class="account-form">

            <div class="account-form-group">

                <label>
                    Mật khẩu hiện tại
                </label>

                <input type="password"
                       name="currentPassword"
                       placeholder="Nhập mật khẩu hiện tại"
                       required />

            </div>


            <div class="account-form-group">

                <label>
                    Mật khẩu mới
                </label>

                <input type="password"
                       name="newPassword"
                       placeholder="Ít nhất 6 ký tự"
                       minlength="6"
                       required />

            </div>


            <div class="account-form-group">

                <label>
                    Xác nhận mật khẩu mới
                </label>

                <input type="password"
                       name="confirmPassword"
                       placeholder="Nhập lại mật khẩu mới"
                       minlength="6"
                       required />

            </div>


            <div class="password-note">

                <strong>💡 Lưu ý</strong>

                <p>
                    Mật khẩu mới phải có ít nhất 6 ký tự và khác
                    mật khẩu hiện tại.
                </p>

            </div>


            <div class="account-form-actions">

                <button type="submit"
                        class="account-btn account-btn-primary">

                    🔒 Đổi mật khẩu

                </button>


                <a href="/AdminAuth/Profile"
                   class="account-btn account-btn-light">

                    ← Quay lại

                </a>

            </div>

        </form>

    </div>

</div>