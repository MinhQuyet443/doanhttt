@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập quản trị</title>
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <div style="max-width:420px;margin:80px auto;background:white;padding:30px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,0.12)">
        <h2 style="margin-top:0">Đăng nhập quản trị</h2>

        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form method="post" action="/AdminAuth/Login" class="admin-form">
            <label>Tên đăng nhập</label>
            <input type="text" name="username" required />

            <label>Mật khẩu</label>
            <input type="password" name="password" required />

            <div class="form-actions">
                <button type="submit" class="btn-save">Đăng nhập</button>
            </div>
        </form>

     
    </div>
</body>
</html>