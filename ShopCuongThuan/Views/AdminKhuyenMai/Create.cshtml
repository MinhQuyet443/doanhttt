@{
    Layout = "_AdminLayout";
    var sanPhams = ViewBag.SanPham as List<ShopCuongThuan.Models.SanPham>;
}

<div class="admin-box">
    <h2>Thêm khuyến mãi</h2>

    <form method="post" action="/AdminKhuyenMai/Create" class="admin-form">
        <label>Sản phẩm</label>
        <select name="MaSP" required>
            @foreach (var sp in sanPhams!)
            {
                <option value="@sp.MaSP">@sp.TenSP</option>
            }
        </select>

        <label>Tên khuyến mãi</label>
        <input type="text" name="TenKM" required />

        <label>Loại giảm giá</label>
        <select name="LoaiGiamGia">
            <option value="PhanTram">Giảm theo phần trăm</option>
            <option value="SoTien">Giảm theo số tiền</option>
        </select>

        <label>Giá trị giảm</label>
        <input type="number" name="GiaTriGiam"
               min="0" step="any" required />

        <label>Ngày bắt đầu</label>
        <input type="date" id="NgayBatDau"
               name="NgayBatDau"
               min="@DateTime.Today.ToString("yyyy-MM-dd")"
               required />

        <label>Ngày kết thúc</label>
        <input type="date" id="NgayKetThuc"
               name="NgayKetThuc"
               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
               required />

        <label>Trạng thái</label>
        <select name="TrangThai">
            <option value="true">Đang áp dụng</option>
            <option value="false">Tạm dừng</option>
        </select>

        <div class="form-actions">
            <button type="submit" class="btn-save">Lưu</button>
            <a href="/AdminKhuyenMai" class="btn-back">Quay lại</a>
        </div>
    </form>
</div>
<script>
    const ngayBatDau = document.getElementById("NgayBatDau");
    const ngayKetThuc = document.getElementById("NgayKetThuc");

    ngayBatDau.addEventListener("change", function () {
        if (ngayBatDau.value) {
            const ngaySauBatDau = new Date(
                ngayBatDau.value + "T00:00:00"
            );

            ngaySauBatDau.setDate(ngaySauBatDau.getDate() + 1);

            const minNgayKetThuc =
                ngaySauBatDau.getFullYear() + "-" +
                String(ngaySauBatDau.getMonth() + 1).padStart(2, "0") + "-" +
                String(ngaySauBatDau.getDate()).padStart(2, "0");

            ngayKetThuc.min = minNgayKetThuc;

            if (ngayKetThuc.value &&
                ngayKetThuc.value < minNgayKetThuc) {
                ngayKetThuc.value = "";
            }
        }
    });
</script>