@model List<ShopCuongThuan.Models.KhuyenMai>

@{
    Layout = "_AdminLayout";
}

<div class="admin-box">
    <div class="admin-title">
        <h2>Quản lý khuyến mãi</h2>
        <form method="get" action="/AdminKhuyenMai" class="admin-search-form">
            <input type="text" name="search" value="@ViewBag.Search"  />
            <button type="submit">Tìm kiếm</button>
            <a href="/AdminKhuyenMai">Tất cả</a>
        </form>
        <a href="/AdminKhuyenMai/Create" class="btn-add">+ Thêm khuyến mãi</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Tên khuyến mãi</th>
                <th>Sản phẩm</th>
                <th>Loại giảm</th>
                <th>Giá trị</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenKM</td>
                    <td>@item.SanPham?.TenSP</td>
                    <td>@item.LoaiGiamGia</td>
                    <td>@item.GiaTriGiam.ToString("N0")</td>
                    <td>
                        @item.NgayBatDau?.ToString("dd/MM/yyyy")
                        -
                        @item.NgayKetThuc?.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @{
                            var trangThai = item.TrangThaiHienThi;
                        }

                        @if (trangThai == "Đang diễn ra")
                        {
                            <span class="badge bg-success">Đang diễn ra</span>
                        }
                        else if (trangThai == "Sắp diễn ra")
                        {
                            <span class="badge bg-warning text-dark">Sắp diễn ra</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Tạm dừng</span>
                        }
                    </td>
                    <td>
                        <a href="/AdminKhuyenMai/Edit/@item.MaKM" class="btn-edit">Sửa</a>

                        <form asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa khuyến mãi này không?');">
                            <input type="hidden" name="id" value="@item.MaKM" />
                            <button type="submit" class="btn btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>