@model List<ShopCuongThuan.Models.KiemKeKhoViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool daKiemKe = ViewBag.DaKiemKe != null && ViewBag.DaKiemKe == true;
}

<div class="admin-card">
    <h2>Kiểm kê kho</h2>
    <form method="get" action="/AdminKiemKeKho" class="admin-search-form">
        <input type="text" name="search" value="@ViewBag.Search"  />
        <button type="submit">Tìm kiếm</button>
        <a href="/AdminKiemKeKho">Tất cả</a>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert-success">@TempData["Success"]</div>
    }

    <form method="get" action="/AdminKiemKeKho" class="admin-filter-form">
        <div>
            <label>Tìm sản phẩm</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Nhập tên sản phẩm" />
        </div>

        <div>
            <label>&nbsp;</label>
            <button type="submit" class="save-btn">Tìm kiếm</button>
        </div>

        <div>
            <label>&nbsp;</label>
            <a href="/AdminKiemKeKho" class="cancel-btn">Tất cả</a>
        </div>
    </form>

    @if (daKiemKe)
    {
        <div class="stat-grid">
            <div class="stat-box">
                <span>Tổng lệch số lượng</span>
                <strong>@ViewBag.TongLechSoLuong</strong>
            </div>

            <div class="stat-box">
                <span>Tổng giá trị chênh lệch</span>
                <strong>@(((decimal)ViewBag.TongGiaTriLech).ToString("N0"))đ</strong>
            </div>

            <div class="stat-box">
                <span>Trạng thái</span>
                <strong>Đã kiểm kê</strong>
            </div>
        </div>
    }

    <form method="post" action="/AdminKiemKeKho/KiemKe">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn hệ thống</th>
                    <th>Tồn thực tế</th>
                    <th>Chênh lệch</th>
                    <th>Giá trị chênh lệch</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];

                    string rowClass = "";

                    if (daKiemKe)
                    {
                        if (item.ChenhLech < 0)
                        {
                            rowClass = "inventory-negative-row";
                        }
                        else if (item.ChenhLech > 0)
                        {
                            rowClass = "inventory-positive-row";
                        }
                    }

                    <tr class="@rowClass">
                        <td>
                            <img src="/images/@item.HinhAnh" class="admin-product-img" />
                        </td>

                        <td>
                            <input type="hidden" name="items[@i].MaSP" value="@item.MaSP" />

                            <strong>@item.TenSP</strong>
                            <br />
                            <small>@item.Hang</small>
                        </td>

                        <td>@item.DanhMuc</td>

                        <td>@item.GiaBan.ToString("N0")đ</td>

                        <td>
                            <strong>@item.TonHeThong</strong>
                        </td>

                        <td>
                            <input type="number"
                                   name="items[@i].TonThucTe"
                                   value="@item.TonThucTe"
                                   min="0"
                                   class="inventory-input" />
                        </td>

                        <td>
                            @if (daKiemKe)
                            {
                                if (item.ChenhLech < 0)
                                {
                                    <span class="inventory-negative">@item.ChenhLech</span>
                                }
                                else if (item.ChenhLech > 0)
                                {
                                    <span class="inventory-positive">+@item.ChenhLech</span>
                                }
                                else
                                {
                                    <span class="inventory-zero">0</span>
                                }
                            }
                            else
                            {
                                <span class="inventory-zero">Chưa tính</span>
                            }
                        </td>

                        <td>
                            @if (daKiemKe)
                            {
                                if (item.GiaTriChenhLech < 0)
                                {
                                    <span class="inventory-negative">
                                        @item.GiaTriChenhLech.ToString("N0")đ
                                    </span>
                                }
                                else if (item.GiaTriChenhLech > 0)
                                {
                                    <span class="inventory-positive">
                                        +@item.GiaTriChenhLech.ToString("N0")đ
                                    </span>
                                }
                                else
                                {
                                    <span class="inventory-zero">0đ</span>
                                }
                            }
                            else
                            {
                                <span class="inventory-zero">Chưa tính</span>
                            }
                        </td>

                        <td>
                            @if (daKiemKe)
                            {
                                if (item.ChenhLech < 0)
                                {
                                    <span class="inventory-negative">Thiếu hàng</span>
                                }
                                else if (item.ChenhLech > 0)
                                {
                                    <span class="inventory-positive">Thừa hàng</span>
                                }
                                else
                                {
                                    <span class="inventory-zero">Khớp</span>
                                }
                            }
                            else
                            {
                                <span>Nhập tồn thực tế</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="submit" class="save-btn">Tính chênh lệch</button>
            <a href="/Admin" class="cancel-btn">Quay lại</a>
        </div>
    </form>

    @if (daKiemKe)
    {
        <form method="post" action="/AdminKiemKeKho/CapNhatTonTheoThucTe" style="margin-top: 14px;">
            @for (int i = 0; i < Model.Count; i++)
            {
                <input type="hidden" name="items[@i].MaSP" value="@Model[i].MaSP" />
                <input type="hidden" name="items[@i].TonThucTe" value="@Model[i].TonThucTe" />
            }

            <button type="submit" class="danger-btn"
                    onclick="return confirm('Bạn có chắc muốn cập nhật tồn hệ thống theo tồn thực tế không?')">
                Cập nhật tồn hệ thống theo thực tế
            </button>
        </form>
    }
</div>