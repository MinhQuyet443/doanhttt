@model ShopCuongThuan.Models.PhieuNhap

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-page-title">
        <div>
            <h2>Chi tiết phiếu nhập PN@Model.MaPN</h2>
            <p class="admin-muted">
                Ngày nhập: @Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <a href="/AdminNhapHang" class="cancel-btn">Quay lại</a>
    </div>

    <div class="stat-grid">
        <div class="stat-box">
            <span>Người nhập</span>
            <strong>@Model.NhanVien?.TenNV</strong>
        </div>

        <div class="stat-box">
            <span>Tổng tiền nhập</span>
            <strong>@Model.TongTien.ToString("N0")đ</strong>
        </div>

        <div class="stat-box">
            <span>Ghi chú</span>
            <strong>@Model.GhiChu</strong>
        </div>
    </div>

    <h3>Sản phẩm nhập</h3>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Sản phẩm</th>
                <th>Số lượng nhập</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.ChiTietPhieuNhaps)
            {
                <tr>
                    <td>
                        <img src="/images/@item.SanPham?.HinhAnh" class="admin-product-img" />
                    </td>

                    <td>
                        <strong>@item.SanPham?.TenSP</strong>
                        <br />
                        <small>@item.SanPham?.Hang</small>
                    </td>

                    <td>
                        <strong>+@item.SoLuongNhap</strong>
                    </td>

 

                    <td>
                        <strong>@item.ThanhTien.ToString("N0")đ</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>