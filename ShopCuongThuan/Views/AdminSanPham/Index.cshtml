@model List<ShopCuongThuan.Models.SanPham>

@{
    Layout = "_AdminLayout";
}

<div class="admin-box">
    <div class="admin-title">
        <h2>Quản lý sản phẩm</h2>
        <form method="get" action="/AdminSanPham" class="admin-search-form">
            <input type="text" name="search" value="@ViewBag.Search"  />
            <button type="submit">Tìm kiếm</button>
            <a href="/AdminSanPham">Tất cả</a>
        </form>
        <a href="/AdminSanPham/Create" class="btn-add">+ Thêm sản phẩm</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Hãng</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="/images/@item.HinhAnh" />
                    </td>
                    <td>@item.TenSP</td>
                    <td>@item.DanhMuc?.TenDM</td>
                    <td>@item.Hang</td>
                    <td>@item.GiaBan.ToString("N0")đ</td>
                    <td>@item.SoLuongTon</td>
                    <td>
                        <a href="/AdminSanPham/Edit/@item.MaSP" class="btn-edit">Sửa</a>

                        <form asp-controller="AdminSanPham"
                              asp-action="Delete"
                              method="post"
                              style="display:inline"
                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm @item.TenSP không?');">

                            <input type="hidden" name="id" value="@item.MaSP" />

                            <button type="submit" class="btn btn-danger">
                                Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>