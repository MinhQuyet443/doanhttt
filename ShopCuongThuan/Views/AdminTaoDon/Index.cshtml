@model List<ShopCuongThuan.Models.SanPham>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <h2>Tạo đơn bán trực tiếp</h2>
    <p class="admin-muted">Dùng cho khách đến mua trực tiếp tại cửa hàng.</p>

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert-error">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert-success">@TempData["Success"]</div>
    }

    <form method="post" action="/AdminTaoDon/CreateDirectOrder">

        <div class="admin-form-grid">
            <div>
                <label>Tên khách hàng</label>
                <input type="text" name="hoTenNhan" placeholder="Khách mua trực tiếp" />
            </div>

            <div>
                <label>Số điện thoại</label>
                <input type="text" name="soDienThoai" placeholder="Có thể bỏ trống" />
            </div>

            <div>
                <label>Địa chỉ</label>
                <input type="text" name="diaChi" value="Mua trực tiếp tại cửa hàng" />
            </div>

            <div>
                <label>Phương thức thanh toán</label>
                <select name="phuongThucThanhToan" required>
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                </select>
            </div>
        </div>
        <div class="form-actions" style="margin: 15px 0;">
            <button type="submit" class="save-btn">
                Tạo đơn
            </button>

            <a href="/Admin" class="cancel-btn">
                Quay lại
            </a>
        </div>

        <h3>Chọn sản phẩm</h3>

        <div style="margin: 15px 0;">
            <input type="text"
                   id="timKiemSanPham"
                   placeholder="Tìm theo tên hoặc mã sản phẩm..."
                   style="width: 100%; max-width: 400px; padding: 10px;" />
        </div>

        <table class="admin-table" id="bangSanPham">
            <thead>
                <tr>
                    <th>Chọn</th>
                    <th>Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Số lượng bán</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="dong-san-pham"
                        data-ten="@item.TenSP.ToLower()"
                        data-ma="@item.MaSP">
                        <td>
                            <input type="checkbox" name="selectedProducts" value="@item.MaSP" />
                        </td>

                        <td>
                            <img src="/images/@item.HinhAnh" class="admin-product-img" />
                        </td>

                        <td>
                            <strong>@item.TenSP</strong>
                            <br />
                            <small>@item.Hang</small>
                        </td>

                        <td>@item.DanhMuc?.TenDM</td>

                        <td>@item.GiaBan.ToString("N0")đ</td>

                        <td>@item.SoLuongTon</td>

                        <td>
                            <input type="number" name="qty_@item.MaSP" value="1" min="1" style="width:90px;" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

       

    </form>
</div>
<script>
    const timKiem = document.getElementById("timKiemSanPham");
    const cacDong = document.querySelectorAll(".dong-san-pham");

    timKiem.addEventListener("input", function () {
        const tuKhoa = timKiem.value.trim().toLowerCase();

        cacDong.forEach(function (dong) {
            const ten = dong.dataset.ten;
            const ma = dong.dataset.ma;

            if (ten.includes(tuKhoa) || ma.includes(tuKhoa)) {
                dong.style.display = "";
            } else {
                dong.style.display = "none";
            }
        });
    });
</script>