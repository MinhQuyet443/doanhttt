@model List<ShopCuongThuan.Models.DonHang>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    decimal tongDoanhThu = ViewBag.TongDoanhThu != null ? (decimal)ViewBag.TongDoanhThu : 0;
    int soDonHang = ViewBag.SoDonHang != null ? (int)ViewBag.SoDonHang : 0;
    int soSanPhamBan = ViewBag.SoSanPhamBan != null ? (int)ViewBag.SoSanPhamBan : 0;

    string tieuDeThongKe = ViewBag.TieuDeThongKe ?? "Doanh thu hôm nay";
}

<div class="admin-card">
    <h2>Thống kê doanh thu</h2>
    

    <div class="admin-stat-filter">
        <form method="get" action="/AdminThongKe" class="stat-filter-box">
            <label>Xem doanh thu theo ngày</label>

            <div class="stat-filter-row">
                <input type="date" name="ngay" value="@ViewBag.Ngay" />
                <button type="submit" class="save-btn">Xem ngày</button>
            </div>
        </form>

        <form method="get" action="/AdminThongKe" class="stat-filter-box">
            <label>Xem doanh thu theo tháng</label>

            <div class="stat-filter-row">
                <input type="month" name="thangNam" value="@ViewBag.ThangNam" />
                <button type="submit" class="save-btn">Xem tháng</button>
            </div>
        </form>

        
    </div>

    <h3>@tieuDeThongKe</h3>

    <div class="stat-grid">
        <div class="stat-box">
            <span>Doanh thu</span>
            <strong>@tongDoanhThu.ToString("N0")đ</strong>
        </div>

        <div class="stat-box">
            <span>Số đơn hàng</span>
            <strong>@soDonHang</strong>
        </div>

        <div class="stat-box">
            <span>Sản phẩm đã bán</span>
            <strong>@soSanPhamBan</strong>
        </div>
    </div>

    <h3>Danh sách đơn hàng</h3>

    @if (Model.Count == 0)
    {
        <div class="admin-empty-box">
            Không có đơn hàng hoàn thành trong thời gian này.
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày bán</th>
                    <th>Khách hàng</th>
                    <th>Thanh toán</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaTraCuu</td>
                        <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.HoTenNhan</td>
                        <td>@item.PhuongThucThanhToan</td>
                        <td>
                            <strong>@item.TongTien.ToString("N0")đ</strong>
                        </td>
                        <td>@item.TrangThai</td>
                        <td>
                            <a href="/AdminDonHang/Details/@item.MaDH" class="edit-btn">Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>